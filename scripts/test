#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
python3 -m unittest discover -s "$root/tests" -p 'test_*.py'
linter=${QMLLINT:-/usr/lib/qt6/bin/qmllint}
if [[ ! -x "$linter" ]]; then
    linter=$(command -v qmllint6 || command -v qmllint || true)
fi
if [[ -z "$linter" || ! -x "$linter" ]]; then
    echo "Qt 6 qmllint is required. Set QMLLINT to its path." >&2
    exit 1
fi
"$linter" "$root"/app/*.qml "$root"/examples/*.qml "$root"/stories/*.qml "$root/shell.qml" "$root"/registry/quickui/*.qml "$root"/stories/primitives/*.qml "$root"/stories/audio/*.qml

runner=${QMLTESTRUNNER:-/usr/lib/qt6/bin/qmltestrunner}
if [[ ! -x "$runner" ]]; then
    runner=$(command -v qmltestrunner6 || command -v qmltestrunner || true)
fi
if [[ -z "$runner" || ! -x "$runner" ]]; then
    echo "Qt 6 qmltestrunner is required. Set QMLTESTRUNNER to its path." >&2
    exit 1
fi

export QT_QPA_PLATFORM=offscreen
export QT_QUICK_BACKEND=software
export QT_FORCE_STDERR_LOGGING=1
exec "$runner" -input "$root/tests" "$@"
