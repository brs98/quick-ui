#!/usr/bin/env python3
"""Install editable QuickUI QML from the bundled, local registry."""

import argparse
import hashlib
import os
import json
from pathlib import Path, PurePosixPath
import re
import sys
import tempfile

ROOT = Path(__file__).resolve().parent
CONFIG_NAME = "quickui.json"


class InstallError(Exception):
    pass


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise InstallError(f"Duplicate JSON key: {key}")
        result[key] = value
    return result


def read_json(path):
    try:
        return json.loads(path.read_text(), object_pairs_hook=unique_object)
    except (ValueError, UnicodeError) as error:
        raise InstallError(f"Invalid JSON in {path}: {error}") from error


def relative_path(value, label):
    if (not isinstance(value, str) or not value or "\\" in value or ":" in value
            or any(ord(char) < 32 for char in value)
            or value.startswith("/") or any(part in ("", ".", "..") for part in value.split("/"))):
        raise InstallError(f"{label} must be a relative path without traversal: {value!r}")
    return PurePosixPath(value)


def checked_path(root, relative, *, directory=False):
    """Reject symlinks and non-directory ancestors, including dangling links."""
    parts = relative.parts
    current = root
    for index, part in enumerate(parts):
        current = current / part
        if current.is_symlink():
            raise InstallError(f"Refusing symlink: {current}")
        if current.exists():
            wants_directory = index < len(parts) - 1 or directory
            if wants_directory and not current.is_dir():
                raise InstallError(f"Expected a directory: {current}")
            if not wants_directory and not current.is_file():
                raise InstallError(f"Expected a regular file: {current}")
    return current


def read_registry():
    path = checked_path(ROOT, PurePosixPath("registry.json"))
    data = read_json(path)
    if not isinstance(data, dict) or type(data.get("schemaVersion")) is not int or data["schemaVersion"] != 1:
        raise InstallError("registry.json must use schemaVersion 1")
    entries = data.get("components")
    if not isinstance(entries, dict) or not entries:
        raise InstallError("registry.json must contain a nonempty components object")
    files = set()
    for name, entry in entries.items():
        if not re.fullmatch(r"[a-z][a-z0-9-]*", name) or not isinstance(entry, dict):
            raise InstallError(f"Invalid registry entry: {name!r}")
        filename = entry.get("file")
        if not isinstance(filename, str) or not re.fullmatch(r"[A-Z][A-Za-z0-9]*\.qml", filename):
            raise InstallError(f"Invalid QML filename for {name}")
        if filename in files:
            raise InstallError(f"Duplicate registry destination: {filename}")
        files.add(filename)
        dependencies = entry.get("dependencies")
        if not isinstance(dependencies, list) or any(not isinstance(dep, str) for dep in dependencies):
            raise InstallError(f"Invalid dependencies for {name}")
        for dependency in dependencies:
            if dependency not in entries:
                raise InstallError(f"Unknown dependency {dependency!r} required by {name}")
    # Validate the entire graph so a broken catalog cannot be partly installed.
    resolve(entries, list(entries))
    return entries


def resolve(entries, requested):
    ordered, visiting, visited = [], set(), set()

    def visit(name):
        if name not in entries:
            raise InstallError(f"Unknown component {name!r}; run 'quickui list'")
        if name in visiting:
            raise InstallError(f"Dependency cycle involving {name}")
        if name in visited:
            return
        visiting.add(name)
        for dependency in entries[name]["dependencies"]:
            visit(dependency)
        visiting.remove(name)
        visited.add(name)
        ordered.append(name)

    for name in requested:
        visit(name)
    return ordered


def project_config(project, initialize):
    path = checked_path(project, PurePosixPath(CONFIG_NAME))
    original = None
    if path.exists():
        original = path.read_bytes()
        data = read_json(path)
        if not isinstance(data, dict) or type(data.get("schemaVersion")) is not int or data["schemaVersion"] != 1:
            raise InstallError("quickui.json must use schemaVersion 1")
    elif initialize:
        data = {"schemaVersion": 1, "componentsDir": "ui"}
    else:
        raise InstallError("No quickui.json found; run 'quickui init' first")
    relative = relative_path(data.get("componentsDir"), "componentsDir")
    if relative.parts[0] == ".quickui":
        raise InstallError("componentsDir cannot use the reserved .quickui source snapshot directory")
    installed = data.setdefault("installed", {})
    if not isinstance(installed, dict):
        raise InstallError("quickui.json installed must be an object")
    for name, record in installed.items():
        if (not re.fullmatch(r"[a-z][a-z0-9-]*", name) or not isinstance(record, dict)
                or not isinstance(record.get("sha256"), str)
                or not re.fullmatch(r"[0-9a-f]{64}", record["sha256"])):
            raise InstallError(f"Invalid installed origin record: {name!r}")
        relative_path(record.get("path"), f"installed.{name}.path")
    return relative, data, original


def write_config(project, content, original):
    """Replace managed metadata atomically; never follow a metadata symlink."""
    path = checked_path(project, PurePosixPath(CONFIG_NAME))
    if original is None:
        with path.open("xb") as stream:
            stream.write(content)
        return
    descriptor, temporary = tempfile.mkstemp(prefix=".quickui-", suffix=".tmp", dir=project)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(content)
        checked_path(project, PurePosixPath(CONFIG_NAME))
        if path.read_bytes() != original:
            raise InstallError("quickui.json changed during installation; rerun the command")
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def fingerprint(content):
    return hashlib.sha256(content).hexdigest()


def base_path(project, digest):
    return checked_path(project, PurePosixPath('.quickui/bases') / digest)


def plan_base(project, content, planned):
    """Store verified pristine sources only; filenames are content addresses."""
    target = base_path(project, fingerprint(content))
    if target.exists():
        if target.read_bytes() != content:
            raise InstallError(f"Corrupt pristine source snapshot: {target}")
    elif not any(path == target for path, _, _ in planned):
        planned.append((target, content, None))


def merge_sources(base, local, incoming):
    """Conservative line-based diff3; unresolved hunks are proposal-only bytes."""
    import difflib
    original = base.splitlines(keepends=True)
    edits = []
    for side, content in enumerate((local, incoming)):
        lines = content.splitlines(keepends=True)
        for operation, start, end, first, last in difflib.SequenceMatcher(None, original, lines, autojunk=False).get_opcodes():
            if operation != 'equal':
                edits.append((start, end, side, lines[first:last]))
    edits.sort(key=lambda edit: (edit[0], edit[1], edit[2]))
    groups = []
    for edit in edits:
        # Insertions on replacement boundaries are deliberately conservative.
        if groups:
            group = groups[-1]
            end = max(item[1] for item in group)
            touches = edit[0] < end or (edit[0] == end and
                       (edit[0] == edit[1] or any(item[0] == item[1] == end for item in group)))
        else:
            touches = False
        if touches:
            group.append(edit)
        else:
            groups.append([edit])

    result, cursor, conflicts = [], 0, 0
    for group in groups:
        start, end = min(item[0] for item in group), max(item[1] for item in group)
        result.extend(original[cursor:start])
        versions = []
        for side in (0, 1):
            part, position = [], start
            for first, last, owner, lines in group:
                if owner != side:
                    continue
                part.extend(original[position:first])
                part.extend(lines)
                position = last
            part.extend(original[position:end])
            versions.append(b''.join(part))
        ancestor = b''.join(original[start:end])
        ours, theirs = versions
        if ours == theirs:
            result.append(ours)
        elif ours == ancestor:
            result.append(theirs)
        elif theirs == ancestor:
            result.append(ours)
        else:
            conflicts += 1
            def terminated(value):
                return value + (b'\n' if value and not value.endswith(b'\n') else b'')
            result.append(b'<<<<<<< local\n' + terminated(ours) + b'||||||| installed base\n'
                          + terminated(ancestor) + b'=======\n' + terminated(theirs) + b'>>>>>>> bundled\n')
        cursor = end
    result.extend(original[cursor:])
    return b''.join(result), conflicts


def review_sources(entries, args):
    """Validate the complete selection before displaying or committing results."""
    import difflib
    project = Path(args.cwd).expanduser().resolve()
    if not project.is_dir():
        raise InstallError(f"Project directory does not exist: {project}")
    directory, config, original_config = project_config(project, False)
    checked_path(project, directory, directory=True)
    installed = config['installed']
    requested = args.components or list(installed)
    unknown = [name for name in requested if name not in entries]
    if unknown:
        raise InstallError('Components absent from bundled registry: ' + ', '.join(unknown))
    if args.command == 'update' and args.components:
        missing = [name for name in requested if name not in installed]
        if missing:
            raise InstallError('Components are not installed: ' + ', '.join(missing) + '; use quickui add')
    names = resolve(entries, requested)
    optional_files = config.get('omarchy', {}).get('files', {}) if isinstance(config.get('omarchy'), dict) else {}
    if not isinstance(optional_files, dict):
        raise InstallError('Invalid optional Omarchy file records in quickui.json')
    rows = []
    for name in names:
        relative = directory / entries[name]['file']
        target = checked_path(project, relative)
        incoming = checked_path(ROOT, PurePosixPath('registry/quickui') / entries[name]['file']).read_bytes()
        record = installed.get(name)
        if record and record['path'] != str(relative):
            raise InstallError(f"Installed destination changed for {name}; restore componentsDir or move owned sources deliberately")
        local = target.read_bytes() if target.exists() else None
        base = None
        if record:
            base_file = base_path(project, record['sha256'])
            if base_file.exists():
                base = base_file.read_bytes()
                if fingerprint(base) != record['sha256']:
                    raise InstallError(f"Corrupt pristine source snapshot: {base_file}")
        if str(relative) in optional_files:
            status = 'integration-managed'
        elif local is None:
            status = 'missing' if record else 'new dependency'
        elif not record:
            status = 'unowned'
        elif local == incoming:
            status = 'current'
        elif fingerprint(local) == record['sha256']:
            status = 'update available'
        elif fingerprint(incoming) == record['sha256']:
            status = 'customized; upstream unchanged'
        else:
            status = 'review required'
        rows.append(dict(name=name, relative=relative, target=target, incoming=incoming,
                         record=record, local=local, base=base, status=status))

    proposals = getattr(args, 'proposals', None)
    proposal_plan = []
    if proposals:
        proposal_dir = relative_path(proposals, 'proposals directory')
        # Never allow proposal output to alias metadata, source, or base storage.
        if (proposal_dir.parts[0] in (CONFIG_NAME, '.quickui') or
                proposal_dir == directory or directory in proposal_dir.parents or proposal_dir in directory.parents):
            raise InstallError('Proposals must use a separate project-relative review directory')
        destination = checked_path(project, proposal_dir, directory=True)
        if destination.exists():
            raise InstallError('Proposal directory already exists; choose a fresh directory')
        manifest = []
        for row in rows:
            if row['status'] in ('current', 'integration-managed'):
                continue
            files = {'bundled.qml': row['incoming']}
            if row['local'] is not None:
                files['local.qml'] = row['local']
            if row['base'] is not None:
                files['base.qml'] = row['base']
            conflicts = None
            if row['base'] is not None and row['local'] is not None:
                files['merged.qml'], conflicts = merge_sources(row['base'], row['local'], row['incoming'])
            for filename, content in files.items():
                target = checked_path(project, proposal_dir / row['name'] / filename)
                proposal_plan.append((target, content, None))
            manifest.append(dict(component=row['name'], path=str(row['relative']), ownership=row['status'],
                                 baseAvailable=row['base'] is not None, conflicts=conflicts,
                                 localSha256=fingerprint(row['local']) if row['local'] is not None else None,
                                 bundledSha256=fingerprint(row['incoming'])))
        note = {'schemaVersion': 1, 'files': manifest,
                'instructions': 'Review local/base/bundled and merged.qml where available. Resolve every conflict and test in your shell. Copy approved bytes manually to the recorded path. Proposals never alter live sources or installed fingerprints. Keep .quickui/bases and quickui.json under version control.'}
        proposal_plan.append((checked_path(project, proposal_dir / 'review.json'),
                              (json.dumps(note, indent=2) + '\n').encode(), None))

    if args.command == 'diff':
        for row in rows:
            print(f"{row['name']}: {row['status']} ({row['relative']}; {'base available' if row['base'] is not None else 'no stored base'})")
            if row['status'] == 'integration-managed':
                print('  Managed by the optional Omarchy recipe installer; use quickui omarchy install.')
                continue
            local = (row['local'] or b'').decode('utf-8', errors='backslashreplace').splitlines(keepends=True)
            incoming = row['incoming'].decode('utf-8', errors='backslashreplace').splitlines(keepends=True)
            for line in difflib.unified_diff(local, incoming, fromfile='local/' + str(row['relative']), tofile='bundled/' + str(row['relative'])):
                print(line, end='' if line.endswith('\n') else '\n')
        if proposal_plan:
            if not args.dry_run:
                commit_plan(project, proposal_plan)
            print(f"{'Would create' if args.dry_run else 'Created'} review proposals in {proposals}; live sources unchanged.")
        if args.dry_run:
            print('Dry run: no files changed.')
        return

    keep_customized = getattr(args, 'keep_customized', False)
    blocked = [row for row in rows if row['status'] == 'unowned' or
               (row['status'] == 'review required' and not keep_customized)]
    if blocked:
        details = ', '.join(row['name'] + ': ' + row['status'] for row in blocked)
        raise InstallError('Update needs review; no files changed (' + details + '). '
                           'Run quickui diff --proposals REVIEW_DIR, review and merge customized sources manually. '
                           'After reviewing, --keep-customized updates only pristine files and retains customized sources unchanged.')
    planned = []
    for row in rows:
        status = row['status']
        if status in ('integration-managed', 'customized; upstream unchanged', 'review required'):
            continue
        if row['local'] != row['incoming']:
            planned.append((row['target'], row['incoming'], row['local']))
        plan_base(project, row['incoming'], planned)
        record = dict(row['record'] or {})
        record.update(path=str(row['relative']), sha256=fingerprint(row['incoming']))
        installed[row['name']] = record
    if json.loads(original_config) != config:
        planned.append((project / CONFIG_NAME, (json.dumps(config, indent=2) + '\n').encode(), original_config))
    if not args.dry_run:
        commit_plan(project, planned)
    for row in rows:
        prefix = 'Would update' if args.dry_run else 'Updated'
        if row['status'] in ('update available', 'missing', 'new dependency'):
            print(f"{prefix} {row['relative']}")
        else:
            print(f"Kept {row['relative']}: {row['status']}")
    if not planned:
        print('No changes.')
    if args.dry_run:
        print('Dry run: no files changed.')


def install(entries, args):
    # Resolving the explicitly selected project permits a symlink to the project
    # itself; all paths inside that project must be ordinary files/directories.
    project = Path(args.cwd).expanduser().resolve()
    if not project.is_dir():
        raise InstallError(f"Project directory does not exist: {project}")
    components_dir, config, original_config = project_config(project, args.command == "init")
    checked_path(project, components_dir, directory=True)
    requested = ["theme"] if args.command == "init" else args.components
    names = resolve(entries, requested)
    planned, unchanged, kept = [], [], []
    snapshots = []
    for name in names:
        filename = entries[name]["file"]
        source = checked_path(ROOT, PurePosixPath("registry/quickui") / filename)
        if not source.is_file():
            raise InstallError(f"Bundled source is missing: {source}")
        content = source.read_bytes()
        relative = components_dir / filename
        target = checked_path(project, relative)
        record = config["installed"].get(name)
        if target.exists():
            if target.read_bytes() != content:
                if name not in requested and record and record["path"] == str(relative):
                    # Source ownership includes edits to dependencies. Retain the
                    # original source fingerprint and never replace the file.
                    kept.append(target)
                    continue
                raise InstallError(f"Refusing to overwrite {target}: contents differ from bundled source. "
                                   "Review and merge changes manually, or choose a fresh destination.")
            unchanged.append(target)
        else:
            planned.append((target, content))
        plan_base(project, content, snapshots)
        config["installed"][name] = dict(record or {}, path=str(relative), sha256=hashlib.sha256(content).hexdigest())
    serialized = (json.dumps(config, indent=2) + "\n").encode()
    # Preserve user formatting and timestamps if managed data did not change.
    metadata_changed = original_config is None or json.loads(original_config) != config
    # Stage sources, pristine snapshots and metadata as a single transaction.
    transaction = [(target, content, None) for target, content in planned] + snapshots
    if metadata_changed:
        transaction.append((project / CONFIG_NAME, serialized, original_config))
    if not args.dry_run:
        commit_plan(project, transaction)
    for target, _ in planned:
        print(f"{'Would create' if args.dry_run else 'Created'} {target.relative_to(project)}")
    if metadata_changed:
        verb = "create" if original_config is None else "update"
        print(f"{'Would ' + verb if args.dry_run else verb.capitalize() + 'd'} {CONFIG_NAME}")
    for target in unchanged:
        print(f"Unchanged {target.relative_to(project)}")
    for target in kept:
        print(f"Kept customized dependency {target.relative_to(project)}")
    if args.dry_run:
        print("Dry run: no files changed.")


def commit_plan(project, planned):
    """Stage new bytes and recovery copies before modifying any live file."""
    import stat
    staged, changed, created_directories = [], [], []
    retained_backups = set()
    try:
        for target, content, original in planned:
            checked_path(project, PurePosixPath(target.relative_to(project).as_posix()))
            if (target.read_bytes() if target.exists() else None) != original:
                raise InstallError(f"File changed during planning: {target}")
            previous_stat = target.stat() if original is not None else None
            missing = []
            parent = target.parent
            while not parent.exists():
                missing.append(parent)
                parent = parent.parent
            for directory in reversed(missing):
                directory.mkdir()
                created_directories.append(directory)
            descriptor, temporary = tempfile.mkstemp(prefix=".quickui-", dir=target.parent)
            entry = dict(target=target, temporary=Path(temporary), content=content,
                         original=original, backup=None)
            staged.append(entry)
            with os.fdopen(descriptor, "wb") as stream:
                stream.write(content)
            if previous_stat is not None:
                os.chmod(temporary, stat.S_IMODE(previous_stat.st_mode))
                descriptor, backup = tempfile.mkstemp(prefix=".quickui-backup-", dir=target.parent)
                entry['backup'] = Path(backup)
                with os.fdopen(descriptor, "wb") as stream:
                    stream.write(original)
                os.chmod(backup, stat.S_IMODE(previous_stat.st_mode))
                os.utime(backup, ns=(previous_stat.st_atime_ns, previous_stat.st_mtime_ns))
        for entry in staged:
            target, temporary, original = entry['target'], entry['temporary'], entry['original']
            checked_path(project, PurePosixPath(target.relative_to(project).as_posix()))
            if (target.read_bytes() if target.exists() else None) != original:
                raise InstallError(f"File changed during installation: {target}")
            if original is None:
                os.link(temporary, target)  # exclusive, atomic creation
                changed.append(entry)
                temporary.unlink()
            else:
                os.replace(temporary, target)
                changed.append(entry)
    except BaseException:
        for entry in reversed(changed):
            target, backup = entry['target'], entry['backup']
            try:
                checked_path(project, PurePosixPath(target.relative_to(project).as_posix()))
                if not target.is_file() or target.read_bytes() != entry['content']:
                    raise InstallError(f"File changed while rolling back: {target}")
                if entry['original'] is None:
                    target.unlink()
                else:
                    # Never truncate a live file to restore it. Recovery bytes
                    # already exist even if the filesystem cannot accept writes.
                    os.replace(backup, target)
            except BaseException:
                if backup is not None:
                    retained_backups.add(backup)
                    print(f"quickui: rollback incomplete for {target}; original preserved at {backup}", file=sys.stderr)
                else:
                    print(f"quickui: rollback incomplete; inspect newly created {target}", file=sys.stderr)
        raise
    finally:
        for entry in staged:
            for temporary in (entry['temporary'], entry['backup']):
                if temporary is not None and temporary not in retained_backups:
                    try:
                        temporary.unlink(missing_ok=True)
                    except OSError:
                        print(f"quickui: temporary recovery file retained at {temporary}", file=sys.stderr)
        for directory in reversed(created_directories):
            try:
                directory.rmdir()
            except OSError:
                pass


def install_preset(entries, args, code, initialize=False):
    import presetlib
    settings = presetlib.decode(code)  # reject invalid codes before reading/writing project
    generated = presetlib.qml_theme(code)
    project = Path(args.cwd).expanduser().resolve()
    if not project.is_dir():
        raise InstallError(f"Project directory does not exist: {project}")
    directory, config, original_config = project_config(project, initialize)
    checked_path(project, directory, directory=True)
    relative = directory / "PresetTheme.qml"
    target = checked_path(project, relative)
    record = config.get("preset")
    if record is not None:
        if (not isinstance(record, dict) or set(record) != {"schemaVersion", "code", "config", "path", "sha256"}
                or type(record["schemaVersion"]) is not int or record["schemaVersion"] != 1
                or not isinstance(record["sha256"], str) or not re.fullmatch(r"[0-9a-f]{64}", record["sha256"])):
            raise InstallError("Invalid preset origin record in quickui.json")
        presetlib.import_config({key: record[key] for key in ("schemaVersion", "code", "config")})
        if relative_path(record["path"], "preset.path") != relative:
            raise InstallError("Preset destination changed; preserve/move owned files deliberately first")
    original = target.read_bytes() if target.exists() else None
    if original is not None and original != generated:
        if not record or hashlib.sha256(original).hexdigest() != record["sha256"]:
            raise InstallError(f"Refusing to overwrite edited or unowned preset theme: {target}")
    planned = []
    theme_relative = directory / entries["theme"]["file"]
    theme_target = checked_path(project, theme_relative)
    if not theme_target.exists():
        source = checked_path(ROOT, PurePosixPath("registry/quickui") / entries["theme"]["file"])
        theme = source.read_bytes()
        planned.append((theme_target, theme, None))
        plan_base(project, theme, planned)
        config["installed"]["theme"] = {"path": str(theme_relative), "sha256": hashlib.sha256(theme).hexdigest()}
    if original != generated:
        planned.append((target, generated, original))
    config["preset"] = dict(presetlib.export(code), path=str(relative), sha256=hashlib.sha256(generated).hexdigest())
    if original_config is None or json.loads(original_config) != config:
        planned.append((project / CONFIG_NAME, (json.dumps(config, indent=2) + "\n").encode(), original_config))
    if not args.dry_run:
        commit_plan(project, planned)
    for path, _, previous in planned:
        action = "create" if previous is None else "update"
        print(f"{'Would ' + action if args.dry_run else action.capitalize() + 'd'} {path.relative_to(project)}")
    if not planned:
        print("Preset unchanged; owned sources preserved.")
    if args.dry_run:
        print("Dry run: no files changed.")
    print(f'Use: import "{directory}" as UI; UI.PresetTheme {{ id: tokens }}')
    if settings["colorSource"] == "system":
        print("Host colors: bind systemTheme to your host Theme object; the palette is the standalone fallback.")



def install_omarchy(args):
    import omarchy_recipe
    import presetlib
    recipe = omarchy_recipe.validate(read_json(Path(args.recipe).expanduser()))
    project = Path(args.cwd).expanduser().resolve()
    if not project.is_dir():
        raise InstallError(f"Project directory does not exist: {project}")
    directory, config, original_config = project_config(project, False)
    checked_path(project, directory, directory=True)
    # A generated preset is shared with `preset apply`; validate its ownership
    # separately, then commit all integration files and metadata in one plan.
    preset_relative = directory / "PresetTheme.qml"
    previous_preset = config.get("preset")
    if previous_preset is not None:
        if (not isinstance(previous_preset, dict)
                or set(previous_preset) != {"schemaVersion", "code", "config", "path", "sha256"}
                or not isinstance(previous_preset["sha256"], str)
                or not re.fullmatch(r"[0-9a-f]{64}", previous_preset["sha256"])):
            raise InstallError("Invalid preset origin record in quickui.json")
        presetlib.import_config({key: previous_preset[key] for key in ("schemaVersion", "code", "config")})
        if relative_path(previous_preset["path"], "preset.path") != preset_relative:
            raise InstallError("Preset destination changed; preserve/move owned files deliberately first")
    optional_sources = ("DesktopThemeSource.qml", "read_theme.py", "OmarchyTokens.js", "ShellThemeSource.qml", "LICENSE.omarchy")
    contents = {}
    for name in optional_sources:
        source = checked_path(ROOT, PurePosixPath("integrations/omarchy-theme") / name)
        contents[PurePosixPath("quickui-omarchy") / name] = source.read_bytes()
    contents[directory / "HostTheme.qml"] = checked_path(ROOT, PurePosixPath("registry/quickui/HostTheme.qml")).read_bytes()
    contents[directory / "OmarchyPreset.qml"] = omarchy_recipe.qml_theme(recipe)
    record = config.get("omarchy")
    previous_files = {}
    if record is not None:
        if (not isinstance(record, dict) or set(record) != {"schemaVersion", "recipe", "files"}
                or type(record["schemaVersion"]) is not int or record["schemaVersion"] != 1
                or not isinstance(record["files"], dict)):
            raise InstallError("Invalid Omarchy origin record in quickui.json")
        omarchy_recipe.validate(record["recipe"])
        previous_files = record["files"]
        if set(previous_files) != {str(path) for path in contents}:
            raise InstallError("Omarchy destinations changed; preserve/move owned files deliberately first")
        for path, fingerprint in previous_files.items():
            relative_path(path, "omarchy.files path")
            if not isinstance(fingerprint, str) or not re.fullmatch(r"[0-9a-f]{64}", fingerprint):
                raise InstallError("Invalid Omarchy file fingerprint in quickui.json")
    planned = []
    fingerprints = {}
    for relative, content in contents.items():
        target = checked_path(project, relative)
        original = target.read_bytes() if target.exists() else None
        fingerprint = previous_files.get(str(relative))
        # A HostTheme copied with `quickui add host-theme` is already owned.
        if relative == directory / "HostTheme.qml" and not fingerprint:
            host_record = config["installed"].get("host-theme")
            if host_record and host_record["path"] == str(relative):
                fingerprint = host_record["sha256"]
        if original is not None and (not fingerprint or hashlib.sha256(original).hexdigest() != fingerprint):
            raise InstallError(f"Refusing to overwrite edited or unowned Omarchy file: {target}")
        if original != content:
            planned.append((target, content, original))
        fingerprints[str(relative)] = hashlib.sha256(content).hexdigest()
    preset_content = presetlib.qml_theme(recipe["preset"])
    preset_target = checked_path(project, preset_relative)
    preset_original = preset_target.read_bytes() if preset_target.exists() else None
    if preset_original is not None and (not previous_preset
            or hashlib.sha256(preset_original).hexdigest() != previous_preset["sha256"]):
        raise InstallError(f"Refusing to overwrite edited or unowned preset theme: {preset_target}")
    if preset_original != preset_content:
        planned.append((preset_target, preset_content, preset_original))
    theme_relative = directory / "Theme.qml"
    theme_target = checked_path(project, theme_relative)
    if not theme_target.exists():
        theme_content = checked_path(ROOT, PurePosixPath("registry/quickui/Theme.qml")).read_bytes()
        planned.append((theme_target, theme_content, None))
        plan_base(project, theme_content, planned)
        config["installed"]["theme"] = {"path": str(theme_relative), "sha256": hashlib.sha256(theme_content).hexdigest()}
    config["preset"] = dict(presetlib.export(recipe["preset"]), path=str(preset_relative),
                            sha256=hashlib.sha256(preset_content).hexdigest())
    host_record = config["installed"].get("host-theme")
    host_relative = directory / "HostTheme.qml"
    if host_record and host_record["path"] == str(host_relative):
        host_record["sha256"] = fingerprints[str(host_relative)]
    config["omarchy"] = {"schemaVersion": 1, "recipe": recipe, "files": fingerprints}
    if json.loads(original_config) != config:
        planned.append((project / CONFIG_NAME, (json.dumps(config, indent=2) + "\n").encode(), original_config))
    # Every source, destination and ownership record is checked before writing.
    if not args.dry_run:
        commit_plan(project, planned)
    for path, _, previous in planned:
        action = "create" if previous is None else "update"
        print(f"{'Would ' + action if args.dry_run else action.capitalize() + 'd'} {path.relative_to(project)}")
    if not planned:
        print("Omarchy integration unchanged; owned sources preserved.")
    if args.dry_run:
        print("Dry run: no files changed.")
    print(f'Use: import "{directory}" as UI; UI.OmarchyPreset {{ hostTokens: source.tokens }}')


def preset_command(args):
    import presetlib
    if args.preset_command == "encode":
        print(presetlib.encode(presetlib.import_config(read_json(Path(args.file).expanduser()))))
    elif args.preset_command == "apply":
        install_preset(read_registry(), args, args.code)
    else:
        exported = presetlib.export(args.code)
        if args.preset_command == "export" or args.json:
            print(json.dumps(exported, indent=2))
        else:
            print(exported["code"])
            for key, value in exported["config"].items():
                print(f"{key}: {value}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("list", help="list bundled components and their dependencies")
    for command in ("diff", "update"):
        child = commands.add_parser(command, help="review local versus bundled sources" if command == "diff" else "transactionally update pristine installed sources")
        child.add_argument("components", nargs="*", help="registry names (default: all installed), including dependencies")
        child.add_argument("--cwd", default=".", metavar="PROJECT")
        child.add_argument("--dry-run", action="store_true", help="validate without writing files or directories")
        if command == "update":
            child.add_argument("--keep-customized", action="store_true", help="after review, skip customized sources even when bundled sources changed; never overwrites them")
        if command == "diff":
            child.add_argument("--proposals", metavar="DIR", help="write local/base/bundled and three-way merge proposals to a fresh project-relative directory; never changes live sources")
    omarchy = commands.add_parser("omarchy", help="install an optional Omarchy theme recipe")
    omarchy_commands = omarchy.add_subparsers(dest="omarchy_command", required=True)
    omarchy_install = omarchy_commands.add_parser("install", help="copy optional adapters and compose a preset")
    omarchy_install.add_argument("--recipe", required=True, metavar="FILE")
    omarchy_install.add_argument("--cwd", default=".", metavar="PROJECT")
    omarchy_install.add_argument("--dry-run", action="store_true")
    preset = commands.add_parser("preset", help="inspect, export, encode, or apply a versioned preset")
    preset_commands = preset.add_subparsers(dest="preset_command", required=True)
    for name in ("inspect", "export", "apply"):
        child = preset_commands.add_parser(name)
        child.add_argument("code")
        if name == "inspect":
            child.add_argument("--json", action="store_true")
        if name == "apply":
            child.add_argument("--cwd", default=".", metavar="PROJECT")
            child.add_argument("--dry-run", action="store_true")
    preset_commands.add_parser("encode").add_argument("file")
    for command, help_text in (("init", "create quickui.json and install Theme.qml"),
                               ("add", "copy components and their dependencies into your project")):
        child = commands.add_parser(command, help=help_text)
        if command == "init":
            child.add_argument("--preset", metavar="CODE", help="install an owned PresetTheme.qml")
        if command == "add":
            child.add_argument("components", nargs="+", help="registry names, e.g. button slider")
        child.add_argument("--cwd", default=".", metavar="PROJECT", help="existing project directory (default: current)")
        child.add_argument("--dry-run", action="store_true", help="validate and show changes without writing")
    args = parser.parse_args()
    try:
        if args.command == "omarchy":
            install_omarchy(args)
            return 0
        if args.command == "preset":
            preset_command(args)
            return 0
        entries = read_registry()
        if args.command == "list":
            for name, entry in entries.items():
                dependencies = ", ".join(entry["dependencies"]) or "none"
                print(f"{name:14} {entry['file']:18} dependencies: {dependencies}")
        elif args.command in ("diff", "update"):
            review_sources(entries, args)
        elif args.command == "init" and args.preset:
            install_preset(entries, args, args.preset, initialize=True)
        else:
            install(entries, args)
    except (InstallError, OSError, RecursionError, ValueError) as error:
        print(f"quickui: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
